{
  "name": "📊 05 - Reporte Semanal de Monetización",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "weeks", "weeksInterval": 1, "triggerAtDay": [1], "triggerAtHour": 9 }] }
      },
      "id": "schedule",
      "name": "Cada Lunes 9am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "url": "=https://www.googleapis.com/blogger/v3/blogs/TU_BLOG_ID_ANIMALES/posts?maxResults=50&status=LIVE",
        "options": {}
      },
      "id": "get-posts-animales",
      "name": "Posts del Blog Animales",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 180],
      "credentials": { "oAuth2Api": { "id": "BLOGGER_OAUTH2_CREDENTIAL_ID", "name": "Google Blogger OAuth2" } }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "url": "=https://www.googleapis.com/blogger/v3/blogs/TU_BLOG_ID_LEYES/posts?maxResults=50&status=LIVE",
        "options": {}
      },
      "id": "get-posts-leyes",
      "name": "Posts del Blog Leyes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 420],
      "credentials": { "oAuth2Api": { "id": "BLOGGER_OAUTH2_CREDENTIAL_ID", "name": "Google Blogger OAuth2" } }
    },
    {
      "parameters": {
        "jsCode": "const animales = $('Posts del Blog Animales').item.json.items || [];\nconst leyes    = $('Posts del Blog Leyes').item.json.items || [];\n\nconst analizar = (posts, nicho) => ({\n  nicho,\n  total: posts.length,\n  monetizados:   posts.filter(p => (p.content||'').includes('go.hotmart.com')).length,\n  sinMonetizar:  posts.filter(p => !(p.content||'').includes('go.hotmart.com')).length,\n  porcentaje:    posts.length ? Math.round(posts.filter(p => (p.content||'').includes('go.hotmart.com')).length / posts.length * 100) : 0,\n  sinMonetizarTitulos: posts.filter(p => !(p.content||'').includes('go.hotmart.com')).slice(0,5).map(p => p.title)\n});\n\nconst resumen = {\n  fecha: new Date().toLocaleDateString('es-ES', { weekday:'long', year:'numeric', month:'long', day:'numeric' }),\n  animales: analizar(animales, 'Animales'),\n  leyes:    analizar(leyes, 'Leyes/Abogados'),\n  totalPosts: animales.length + leyes.length,\n  totalMonetizados: animales.filter(p => (p.content||'').includes('go.hotmart.com')).length +\n                    leyes.filter(p    => (p.content||'').includes('go.hotmart.com')).length\n};\n\nreturn [{ json: resumen }];"
      },
      "id": "analizar",
      "name": "Analizar Monetización",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.item.json;\n\nconst barra = (pct) => {\n  const llenos = Math.round(pct / 10);\n  return '█'.repeat(llenos) + '░'.repeat(10 - llenos) + ` ${pct}%`;\n};\n\nconst html = `\n<div style=\"font-family:Arial,sans-serif;max-width:600px;background:#1a1a1a;border-radius:16px;padding:28px;color:#fff\">\n  <h2 style=\"margin:0 0 4px;font-size:22px\">📊 Reporte Semanal de Monetización</h2>\n  <p style=\"color:#aaa;font-size:14px;margin:0 0 24px\">${r.fecha}</p>\n\n  <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px\">\n    <div style=\"background:#2a2a2a;border-radius:10px;padding:16px\">\n      <p style=\"color:#aaa;font-size:12px;margin:0 0 4px\">TOTAL ARTÍCULOS</p>\n      <p style=\"font-size:28px;font-weight:800;margin:0;color:#fff\">${r.totalPosts}</p>\n    </div>\n    <div style=\"background:#2a2a2a;border-radius:10px;padding:16px\">\n      <p style=\"color:#aaa;font-size:12px;margin:0 0 4px\">CON HOTMART</p>\n      <p style=\"font-size:28px;font-weight:800;margin:0;color:#2ecc71\">${r.totalMonetizados}</p>\n    </div>\n  </div>\n\n  <div style=\"background:#2a2a2a;border-radius:10px;padding:16px;margin-bottom:12px\">\n    <p style=\"color:#2ecc71;font-weight:700;margin:0 0 8px\">🐾 Blog Animales</p>\n    <p style=\"font-family:monospace;font-size:13px;color:#fff;margin:0 0 6px\">${barra(r.animales.porcentaje)}</p>\n    <p style=\"color:#aaa;font-size:13px;margin:0\">${r.animales.monetizados}/${r.animales.total} posts monetizados · ${r.animales.sinMonetizar} pendientes</p>\n    ${r.animales.sinMonetizarTitulos.length ? `<p style=\"color:#e74c3c;font-size:12px;margin:8px 0 0\">Pendientes: ${r.animales.sinMonetizarTitulos.join(', ')}</p>` : ''}\n  </div>\n\n  <div style=\"background:#2a2a2a;border-radius:10px;padding:16px\">\n    <p style=\"color:#3498db;font-weight:700;margin:0 0 8px\">⚖️ Blog Leyes</p>\n    <p style=\"font-family:monospace;font-size:13px;color:#fff;margin:0 0 6px\">${barra(r.leyes.porcentaje)}</p>\n    <p style=\"color:#aaa;font-size:13px;margin:0\">${r.leyes.monetizados}/${r.leyes.total} posts monetizados · ${r.leyes.sinMonetizar} pendientes</p>\n  </div>\n\n  <p style=\"color:#555;font-size:11px;text-align:center;margin:20px 0 0\">Generado automáticamente por n8n · ${new Date().toISOString()}</p>\n</div>`;\n\nreturn [{ json: { ...r, htmlReporte: html } }];"
      },
      "id": "generar-reporte",
      "name": "Generar HTML del Reporte",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 300]
    },
    {
      "parameters": {
        "sendTo": "kromasoldeluis@gmail.com",
        "subject": "=📊 Reporte Monetización {{ new Date().toLocaleDateString('es-ES') }} — {{ $json.totalMonetizados }}/{{ $json.totalPosts }} posts",
        "emailType": "html",
        "message": "={{ $json.htmlReporte }}",
        "options": {}
      },
      "id": "enviar-email",
      "name": "Enviar Email Reporte",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1180, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "GMAIL_CREDENTIAL_ID",
          "name": "Gmail OAuth2"
        }
      }
    }
  ],
  "connections": {
    "Cada Lunes 9am":       { "main": [[{ "node": "Posts del Blog Animales", "type": "main", "index": 0 }], [{ "node": "Posts del Blog Leyes", "type": "main", "index": 0 }]] },
    "Posts del Blog Animales": { "main": [[{ "node": "Analizar Monetización", "type": "main", "index": 0 }]] },
    "Posts del Blog Leyes":    { "main": [[{ "node": "Analizar Monetización", "type": "main", "index": 0 }]] },
    "Analizar Monetización": { "main": [[{ "node": "Generar HTML del Reporte", "type": "main", "index": 0 }]] },
    "Generar HTML del Reporte": { "main": [[{ "node": "Enviar Email Reporte",  "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["reporte", "monetizacion", "email", "semanal"],
  "triggerCount": 1
}
