        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ kind: 'blogger#post', blog: { id: $('Compute Schedule Slot').item.json.BLOGGER_ID }, title: $('Compute Schedule Slot').item.json.TEMA_ARTICULO, content: $('Compute Schedule Slot').item.json.HTML_FINAL, labels: [$('Compute Schedule Slot').item.json.NICHO || 'general'], published: $('Compute Schedule Slot').item.json.SCHEDULED_FOR }) }}",
        "options": { "timeout": 30000 }
      },
      "id": "blogger-retry",
      "name": "Retry Blogger Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 360],
      "credentials": { "googleOAuth2Api": { "name": "Google Sheets account" } },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Normalize success from either first attempt or retry\nconst fromRetry = $('Retry Blogger Post').item?.json;\nconst fromFirst = $('Publish to Blogger').item?.json;\nconst data = (fromRetry?.url || fromRetry?.id) ? fromRetry : fromFirst;\n\nif (!data?.url && !data?.id) {\n  throw new Error('Blogger publish failed: ' + JSON.stringify(data).slice(0,300));\n}\n\nconst slot = $('Compute Schedule Slot').item.json;\nreturn {\n  json: {\n    ID_UNICO:       slot.ID_UNICO,\n    BLOGGER_ID:     slot.BLOGGER_ID,\n    URL_FINAL:      data.url || `https://www.blogger.com/blog/post/${slot.BLOGGER_ID}/${data.id}`,\n    POST_ID:        data.id,\n    SCHEDULED_FOR:  slot.SCHEDULED_FOR,\n    PUBLISHED_AT:   new Date().toISOString()\n  }\n};"
      },
