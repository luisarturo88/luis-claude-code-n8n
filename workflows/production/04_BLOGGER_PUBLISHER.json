      "id": "read-schedule",
      "name": "Read Pipeline for Slot",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [900, 420],
      "credentials": { "googleSheetsOAuth2Api": { "name": "Google Sheets account" } }
    },
    {
      "parameters": {
        "jsCode": "// Slow scheduling: find next available 20-min Blogger slot\n// so articles publish even if VPS goes down\nconst pipelineRows = $('Read Pipeline for Slot').all().map(i => i.json);\nconst passData = $('Pass Data').item.json;\n\n// Find max SCHEDULED_FOR across all rows (articles already uploaded)\nlet maxSlot = Date.now();\nfor (const row of pipelineRows) {\n  if (row.SCHEDULED_FOR) {\n    const t = new Date(row.SCHEDULED_FOR).getTime();\n    if (!isNaN(t) && t > maxSlot) maxSlot = t;\n  }\n}\n\n// Next slot: max(lastSlot, now) + 20 minutes — Blogger will auto-publish\nconst INTERVAL_MS = 20 * 60 * 1000; // 20 minutes\nconst nowMs = Date.now();\nconst baseMs = Math.max(maxSlot, nowMs);\nconst nextSlotMs = baseMs + INTERVAL_MS;\nconst scheduledFor = new Date(nextSlotMs).toISOString();\n\nreturn {\n  json: {\n    ...passData,\n    SCHEDULED_FOR: scheduledFor\n  }\n};"
      },
      "id": "compute-slot",
      "name": "Compute Schedule Slot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 360]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://www.googleapis.com/blogger/v3/blogs/{{ $json.BLOGGER_ID }}/posts/?isDraft=false",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ kind: 'blogger#post', blog: { id: $json.BLOGGER_ID }, title: $json.TEMA_ARTICULO, content: $json.HTML_FINAL, labels: [$json.NICHO || 'general'], published: $json.SCHEDULED_FOR }) }}",
        "options": { "timeout": 30000 }
      },
      "id": "blogger-post",
      "name": "Publish to Blogger",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300],
      "credentials": { "googleOAuth2Api": { "name": "Google Sheets account" } },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "check-429",
              "leftValue": "={{ $json.error?.httpCode || $json.statusCode }}",
              "rightValue": "429",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
