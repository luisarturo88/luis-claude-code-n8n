    {
      "parameters": {
        "jsCode": "const pipeline = $('Take 1 Row').item.json;\nconst blogs = $input.all().map(i => i.json);\nconst blog = blogs.find(b => String(b.ID_BLOG).trim() === String(pipeline.ID_BLOG).trim()) || {};\n\nconst idioma = blog.IDIOMA || pipeline.IDIOMA || 'es';\nconst nicho = (blog.NICHO || pipeline.NICHO || 'general').toLowerCase();\nconst bloggerId = String(blog.BLOGGER_ID || '').trim();\nconst keyword = pipeline.KEYWORD || pipeline.TEMA_ARTICULO || '';\n\nif (!pipeline.ID_BLOG || !pipeline.TEMA_ARTICULO || !bloggerId) {\n  console.log('Skipping corrupted row: ID_BLOG=' + pipeline.ID_BLOG + ' BLOGGER_ID=' + bloggerId);\n  return [];\n}\n\nconst isEs = idioma !== 'en';\nconst isVet = ['veterinaria','bovinos','ganaderia','pecuario','animal'].some(n => nicho.includes(n));\n\nlet systemPrompt;\nif (isVet && isEs) {\n  systemPrompt = 'Eres el Dr. Luis Arturo García, Médico Veterinario especializado en producción animal. Escribes artículos técnico-prácticos en HTML puro. PROHIBIDO: html, body, head, h1. Empieza con p. Sin texto fuera del HTML.';\n} else if (isEs) {\n  systemPrompt = 'Eres un experto SEO en el nicho de ' + nicho + '. Escribes artículos en español en HTML puro. PROHIBIDO: html, body, head, h1. Empieza con p. Sin markdown ni texto fuera del HTML.';\n} else {\n  systemPrompt = 'You are an SEO expert in the ' + nicho + ' niche. Write articles in English using pure HTML. FORBIDDEN: html, body, head, h1. Start with p. No markdown, no text outside HTML.';\n}\n\nconst userPrompt = isEs\n  ? 'TEMA: ' + pipeline.TEMA_ARTICULO + '. KEYWORD PRINCIPAL: ' + keyword + '. NICHO: ' + nicho + '. INSTRUCCIONES: Redacta artículo SEO completo en HTML puro. Mínimo 1200 palabras. Empieza con p. Mínimo 5 secciones h2. Incluye keyword en primer párrafo. Agrega sección FAQ con 6 preguntas y respuestas. Lenguaje claro y práctico. Devuelve SOLO HTML puro, sin explicaciones previas.'\n  : 'TOPIC: ' + pipeline.TEMA_ARTICULO + '. MAIN KEYWORD: ' + keyword + '. NICHE: ' + nicho + '. INSTRUCTIONS: Write complete SEO article in pure HTML. Minimum 1200 words. Start with p. Minimum 5 h2 sections. Include keyword in first paragraph. Add FAQ section with 6 questions and answers. Clear practical language. Return ONLY pure HTML, no explanations.';\n\nconsole.log('Procesando: ' + pipeline.ID_UNICO + ' | Blog: ' + bloggerId + ' | Nicho: ' + nicho);\n\nreturn [{ json: {\n  ID_UNICO:      pipeline.ID_UNICO,\n  TEMA_ARTICULO: pipeline.TEMA_ARTICULO,\n  ID_BLOG:       pipeline.ID_BLOG,\n  BLOGGER_ID:    bloggerId,\n  NICHO:         nicho,\n  IDIOMA:        idioma,\n  KEYWORD:       keyword,\n  row_number:    pipeline.row_number,\n  systemPrompt:  systemPrompt,\n  userPrompt:    userPrompt\n} }];"
      },
