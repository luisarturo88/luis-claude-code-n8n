{
  "id": "wf01-master-simple",
  "name": "01_MASTER_SCHEDULER",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 20 }] }
      },
      "id": "cron",
      "name": "Every 20 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "documentId": { "__rl": true, "value": "18BQ8BjfTvVa56R5FjWyBuvcGR8vVlz0rx-hwAVBdPug", "mode": "id" },
        "sheetName": { "__rl": true, "value": "CONTENT_PIPELINE", "mode": "name" },
        "options": {}
      },
      "id": "read-pipeline",
      "name": "Read CONTENT_PIPELINE",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [460, 300],
      "credentials": { "googleSheetsOAuth2Api": { "name": "Google Sheets account" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-pending",
              "leftValue": "={{ String($json.STATUS ?? '').toUpperCase().trim() }}",
              "rightValue": "PENDING",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-pending",
      "name": "Filter PENDING",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "sortFieldsUi": {
          "sortField": [
            { "fieldName": "PRIORITY", "order": "ascending" },
            { "fieldName": "ID_UNICO",  "order": "ascending" }
          ]
        },
        "options": {}
      },
      "id": "sort-priority",
      "name": "Sort by Priority",
      "type": "n8n-nodes-base.sort",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "operation": "limit",
        "maxItems": 1
      },
      "id": "take-one",
      "name": "Take 1 Row",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "ACTUALIZAR_ID_WF02",
          "mode": "id"
        },
        "options": { "waitForSubWorkflow": true },
        "fields": {
          "values": [
            { "name": "ID_UNICO",      "stringValue": "={{ $json.ID_UNICO }}" },
            { "name": "TEMA_ARTICULO", "stringValue": "={{ $json.TEMA_ARTICULO }}" },
            { "name": "KEYWORD",       "stringValue": "={{ $json.KEYWORD || '' }}" },
            { "name": "ID_BLOG",       "stringValue": "={{ $json.ID_BLOG }}" },
            { "name": "NICHO",         "stringValue": "={{ $json.NICHO || '' }}" },
            { "name": "IDIOMA",        "stringValue": "={{ $json.IDIOMA || 'es' }}" }
          ]
        }
      },
      "id": "run-wf02",
      "name": "02 Generar Contenido",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-html",
              "leftValue": "={{ $json.HTML_FINAL }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-html",
      "name": "Tiene HTML?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "ACTUALIZAR_ID_WF04",
          "mode": "id"
        },
        "options": { "waitForSubWorkflow": true },
        "fields": {
          "values": [
            { "name": "ID_UNICO",      "stringValue": "={{ $json.ID_UNICO }}" },
            { "name": "TEMA_ARTICULO", "stringValue": "={{ $json.TEMA_ARTICULO }}" },
            { "name": "ID_BLOG",       "stringValue": "={{ $json.ID_BLOG }}" },
            { "name": "BLOGGER_ID",    "stringValue": "={{ $json.BLOGGER_ID }}" },
            { "name": "HTML_FINAL",    "stringValue": "={{ $json.HTML_FINAL }}" },
            { "name": "NICHO",         "stringValue": "={{ $json.NICHO || '' }}" },
            { "name": "IDIOMA",        "stringValue": "={{ $json.IDIOMA || 'es' }}" }
          ]
        }
      },
      "id": "run-wf04",
      "name": "04 Publicar Blogger",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [1780, 220]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "value": "18BQ8BjfTvVa56R5FjWyBuvcGR8vVlz0rx-hwAVBdPug", "mode": "id" },
        "sheetName": { "__rl": true, "value": "CONTENT_PIPELINE", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "ID_UNICO": "={{ $('Take 1 Row').item.json.ID_UNICO }}",
            "STATUS":   "FAILED"
          },
          "matchingColumns": ["ID_UNICO"],
          "schema": [
            { "id": "ID_UNICO", "displayName": "ID_UNICO", "required": false, "defaultMatch": true,  "canBeUsedToMatch": true,  "display": true, "type": "string", "removed": false },
            { "id": "STATUS",   "displayName": "STATUS",   "required": false, "defaultMatch": false, "canBeUsedToMatch": false, "display": true, "type": "string", "removed": false }
          ]
        },
        "options": {}
      },
      "id": "mark-failed",
      "name": "Marcar FAILED",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1780, 400],
      "credentials": { "googleSheetsOAuth2Api": { "name": "Google Sheets account" } }
    }
  ],
  "connections": {
    "Every 20 Minutes":   { "main": [[{ "node": "Read CONTENT_PIPELINE", "type": "main", "index": 0 }]] },
    "Read CONTENT_PIPELINE": { "main": [[{ "node": "Filter PENDING",       "type": "main", "index": 0 }]] },
    "Filter PENDING":     { "main": [[{ "node": "Sort by Priority",       "type": "main", "index": 0 }]] },
    "Sort by Priority":   { "main": [[{ "node": "Take 1 Row",             "type": "main", "index": 0 }]] },
    "Take 1 Row":         { "main": [[{ "node": "02 Generar Contenido",   "type": "main", "index": 0 }]] },
    "02 Generar Contenido": { "main": [[{ "node": "Tiene HTML?",          "type": "main", "index": 0 }]] },
    "Tiene HTML?": {
      "main": [
        [{ "node": "04 Publicar Blogger", "type": "main", "index": 0 }],
        [{ "node": "Marcar FAILED",       "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "executionTimeout": 3600
  },
  "meta": { "instanceId": "production" }
}
