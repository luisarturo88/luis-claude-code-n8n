    {
      "parameters": {
        "jsCode": "const PEXELS_API_KEY = 'uM57jRMv7kYk0CiSJpecMFL5jN75D28QMJ0a1cU4XVhQdKgPZ2w2Me5r';\n\nconst tema = $json.TEMA_ARTICULO || $('Preparar Datos').item.json.TEMA_ARTICULO || 'blog';\nconst keyword = $json.KEYWORD || $('Preparar Datos').item.json.KEYWORD || '';\n\nconst queryRaw = (tema + ' ' + keyword).toLowerCase();\nconst queryWords = queryRaw\n  .replace(/[^a-záéíóúñ\\s]/gi, '')\n  .split(' ')\n  .filter(w => w.length > 3)\n  .slice(0, 3)\n  .join(' ');\n\nconst searchTerms = [queryWords, 'nature field outdoor', 'landscape countryside'];\n\nlet imageUrl = '';\nlet imageAlt = tema;\nlet imageCredit = '';\nlet imageCreditUrl = '';\n\nfor (const term of searchTerms) {\n  try {\n    const url = 'https://api.pexels.com/v1/search?query=' + encodeURIComponent(term) + '&per_page=5&orientation=landscape';\n    const response = await fetch(url, { headers: { 'Authorization': PEXELS_API_KEY } });\n    if (response.ok) {\n      const data = await response.json();\n      if (data.photos && data.photos.length > 0) {\n        const idx = Math.floor(Math.random() * Math.min(5, data.photos.length));\n        const photo = data.photos[idx];\n        imageUrl = photo.src.large2x || photo.src.large || photo.src.original;\n        imageAlt = photo.alt || tema;\n        imageCredit = photo.photographer;\n        imageCreditUrl = photo.photographer_url;\n        break;\n      }\n    }\n  } catch(e) { continue; }\n}\n\nif (!imageUrl) {\n  imageUrl = 'https://images.unsplash.com/photo-1500595046743-cd271d694d30?w=1200&q=80';\n  imageAlt = tema;\n  imageCredit = 'Unsplash';\n  imageCreditUrl = 'https://unsplash.com';\n}\n\nreturn [{\n  validatedHTML: $json.validatedHTML,\n  rowNumber: $json.rowNumber,\n  BLOGGER_ID: $json.BLOGGER_ID,\n  TEMA_ARTICULO: $json.TEMA_ARTICULO,\n  KEYWORD: $json.KEYWORD,\n  pexels_imageUrl: imageUrl,\n  pexels_imageAlt: imageAlt,\n  pexels_imageCredit: imageCredit,\n  pexels_imageCreditUrl: imageCreditUrl\n}];"
      },
