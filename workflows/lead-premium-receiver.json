    {
      "id": "node-reply-parse",
      "name": "📞 Parsear Respuesta Twilio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 1380],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const wh  = $('🔔 Webhook: Respuestas Twilio').first().json;\nconst cfg = $('⚙️ CONFIG Twilio Reply').first().json;\nconst body = wh.body || wh;\n\nconst fromPhone = (body.From || '').replace(/\\D/g, '');\nconst msgBody   = (body.Body || '').trim();\nconst mediaUrl  = body.MediaUrl0 || '';\nconst isConfirm = /^(s[ií]|yes|ok|listo|confirmado|confirmo)/i.test(msgBody);\nconst isDecline = /^(no|cancel|reagend)/i.test(msgBody);\n\nreturn { json: {\n  fromPhone, msgBody, mediaUrl, isConfirm, isDecline,\n  rawFrom: body.From || '',\n  SHEET_ID_LEADS: cfg.SHEET_ID_LEADS,\n  HOJA_PREMIUM:   cfg.HOJA_PREMIUM\n}};\n"
      }
    },
    {
      "id": "node-reply-read-sheet",
      "name": "📊 Sheet: Leer Leads Premium",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [960, 1380],
