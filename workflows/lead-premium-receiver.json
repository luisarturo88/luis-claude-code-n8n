    },
    {
      "id": "node-find-row",
      "name": "🗺️ Localizar Fila del Blog",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1500, 620],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const leadData  = $('🔍 Extraer Datos del Lead').first().json;\nconst sheetRows = $input.all().map(i => i.json);\n\nlet matchRow = null;\nif (leadData.blogId) {\n  matchRow = sheetRows.find(r => String(r.BLOG_ID).trim() === leadData.blogId);\n}\nif (!matchRow && leadData.blogName) {\n  const bn = leadData.blogName.toLowerCase();\n  matchRow = sheetRows.find(r =>\n    (r.BLOG_NAME || '').toLowerCase().includes(bn) ||\n    bn.includes((r.BLOG_NAME || '').toLowerCase())\n  );\n}\n\nif (!matchRow) {\n  return [{ json: {\n    _noMatch: true,\n    message: `No se encontró blog para blog_id=${leadData.blogId} / blog_name=${leadData.blogName}`,\n    leadData\n  }}];\n}\n\nconst currentTotal = parseInt(matchRow.LEADS_PREMIUM_TOTAL || 0);\n\nreturn [{ json: {\n  _noMatch:  false,\n  rowNumber: matchRow._rowNumber,\n  BLOG_NAME: matchRow.BLOG_NAME,\n  BLOG_ID:   matchRow.BLOG_ID,\n  newTotal:  currentTotal + 1,\n  ...leadData\n}}];\n"
      }
    },
