    {
      "id": "node-prep-sms",
      "name": "📞 Preparar SMS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2540, 520],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $('🔍 Extraer Datos del Lead').first().json;\nconst blog = $('🗺️ Localizar Fila del Blog').first().json;\nconst cfg  = $('⚙️ CONFIG Lead Premium').first().json;\n\n// ── Formatear teléfono para Twilio ───────────────────────────────────────────\nlet raw = (data.phone || '').replace(/\\D/g, '');\nif (raw.length === 10) raw = '1' + raw;\nconst validPhone = /^1\\d{10}$/.test(raw);\nconst phone = '+' + raw;\n\n// ── Calcular offset Eastern Time (con DST automático) ────────────────────────\nfunction getETOffset(d) {\n  const y = d.getUTCFullYear();\n  const m1 = new Date(Date.UTC(y, 2, 1));\n  const dstStart = new Date(Date.UTC(y, 2, 8 + (7 - m1.getUTCDay()) % 7));\n  const n1 = new Date(Date.UTC(y, 10, 1));\n  const dstEnd   = new Date(Date.UTC(y, 10, 1 + (7 - n1.getUTCDay()) % 7));\n  return (d >= dstStart && d < dstEnd) ? -4 : -5;\n}\n\n// ── Recalibrar al siguiente momento hábil (9am-6pm ET, L-V) ──────────────────\nfunction clampBusiness(d) {\n  const off = getETOffset(d);\n  const et  = new Date(d.getTime() + off * 3600000);\n  const h   = et.getUTCHours();\n  const dow = et.getUTCDay();\n  if (dow === 0 || dow === 6) {\n    et.setUTCDate(et.getUTCDate() + (dow === 0 ? 1 : 2));\n    et.setUTCHours(9, 0, 0, 0);\n  } else if (h < 9) {\n    et.setUTCHours(9, 0, 0, 0);\n  } else if (h >= 18) {\n    et.setUTCDate(et.getUTCDate() + (dow === 5 ? 3 : 1));\n    et.setUTCHours(9, 0, 0, 0);\n  } else {\n    return d; // dentro del horario laboral, sin cambio\n  }\n  return new Date(et.getTime() - off * 3600000);\n}\n\nconst now = new Date();\nconst off = getETOffset(now);\n\n// Cita: próximo día hábil a las 10am ET\nconst etNow = new Date(now.getTime() + off * 3600000);\netNow.setUTCDate(etNow.getUTCDate() + 1);\netNow.setUTCHours(10, 0, 0, 0);\nconst dow0 = etNow.getUTCDay();\nif (dow0 === 0) etNow.setUTCDate(etNow.getUTCDate() + 1); // Dom → Lun\nif (dow0 === 6) etNow.setUTCDate(etNow.getUTCDate() + 2); // Sáb → Lun\nconst appointmentUTC = new Date(etNow.getTime() - off * 3600000);\n\n// Tiempos de espera (respetando horario laboral)\nconst wait1hUTC       = clampBusiness(new Date(now.getTime() + 3600000));\nconst announcementUTC = clampBusiness(new Date(wait1hUTC.getTime() + 4 * 3600000));\nconst preCallUTC      = new Date(appointmentUTC.getTime() - 15 * 60000);\n\n// Nombre del día de la cita en español\nconst days = ['domingo','lunes','martes','miércoles','jueves','viernes','sábado'];\nconst apptET  = new Date(appointmentUTC.getTime() + off * 3600000);\nconst apptH   = apptET.getUTCHours();\nconst apptDay = days[apptET.getUTCDay()];\nconst apptTimeStr = `${apptH % 12 || 12}:00 ${apptH >= 12 ? 'PM' : 'AM'} ET`;\n\n// Configurar canal Twilio\nconst channel = cfg.TWILIO_CHANNEL || 'sms';\nconst from    = cfg.TWILIO_FROM;\nconst fromFmt = channel === 'whatsapp' ? `whatsapp:${from}` : from;\nconst toFmt   = channel === 'whatsapp' ? `whatsapp:${phone}` : phone;\nconst name    = data.firstName || 'estimado/a';\nconst audioUrl = cfg.AUDIO_URL || 'https://tuservidor.com/audio-bienvenida.mp3';\n\n// Generar header de autenticación Basic para Twilio\nconst auth = Buffer.from(`${cfg.TWILIO_ACCOUNT_SID}:${cfg.TWILIO_AUTH_TOKEN}`).toString('base64');\n\nreturn { json: {\n  phone, toFmt, fromFmt, validPhone,\n  TWILIO_URL:         `https://api.twilio.com/2010-04-01/Accounts/${cfg.TWILIO_ACCOUNT_SID}/Messages.json`,\n  TWILIO_AUTH_HEADER: `Basic ${auth}`,\n  msgBienvenida:   `Hola ${name}, hemos recibido tu caso. 🎧 Escucha este audio de 2 min con los próximos pasos:\\n${audioUrl}\\n\\nResponde con los detalles: tipo de caso, fecha, descripción y fotos si tienes.`,\n  msgRecordatorio: `Hola ${name}, solo un recordatorio: aún esperamos los detalles de tu caso para que el abogado llegue preparado. Responde con texto o fotos cuando puedas.`,\n  msgLlamada:      `Estimado/a ${name}, el ${apptDay} a las ${apptTimeStr} un abogado especialista te llamará al número registrado.\\n\\nResponde SÍ para confirmar tu disponibilidad, o NO si necesitas reagendar.`,\n  msgPrellamada:   `${name}, tu llamada con el abogado comienza en 15 minutos ⏰. Ten a mano cualquier documento relevante. Responde LISTO cuando estés preparado/a.`,\n  wait1hUntil:       wait1hUTC.toISOString(),\n  announcementUntil: announcementUTC.toISOString(),\n  preCallUntil:      preCallUTC.toISOString(),\n  appointmentUTC:    appointmentUTC.toISOString(),\n  apptDay, apptTimeStr,\n  rowNumber:  blog.rowNumber,\n  SHEET_ID:   blog.SHEET_ID,\n  HOJA_BLOGS: blog.HOJA_BLOGS,\n  firstName:  name,\n  email:      data.email\n}};\n"
      }
    },
