      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "ri01", "name": "SHEET_ID",   "value": "1Vq8TuyqI22C3_Ffth-GsGdDRuXfHORpdAGOiowLxIpk", "type": "string" },
