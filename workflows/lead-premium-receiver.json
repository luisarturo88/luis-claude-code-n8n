    {
      "id": "node-reply-find-row",
      "name": "🗺️ Localizar Lead por Teléfono",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1220, 1380],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const parsed    = $('📞 Parsear Respuesta Twilio').first().json;\nconst rows      = $input.all().map(i => i.json);\nconst fromPhone = parsed.fromPhone;\n\n// Buscar por columna TELEFONO en Leads premium\nconst match = rows.find(r => {\n  const p = (r.TELEFONO || '').replace(/\\D/g, '');\n  return p === fromPhone || p === fromPhone.replace(/^1/, '') || '1' + p === fromPhone;\n});\n\nif (!match) {\n  return [{ json: { _noMatch: true, fromPhone, ...parsed } }];\n}\n\nconst now = new Date();\nconst ts  = now.toLocaleString('es-MX', { timeZone: 'America/New_York' });\nconst infoActual = match.LEAD_PREMIUM_INFO_RECOLECTADA || '';\nconst newMsg  = `[${ts} ET] ${parsed.msgBody}${parsed.mediaUrl ? '\\nFoto: ' + parsed.mediaUrl : ''}`;\nconst newInfo = infoActual ? infoActual + '\\n' + newMsg : newMsg;\n\nlet newFase = match.LEAD_PREMIUM_FASE || '1';\nif (parsed.isConfirm) newFase = '4';\n\nreturn [{ json: {\n  _noMatch: false,\n  email:   match.EMAIL,\n  LEAD_PREMIUM_INFO_RECOLECTADA: newInfo,\n  LEAD_PREMIUM_CONFIRMADO:       parsed.isConfirm ? 'TRUE' : '',\n  LEAD_PREMIUM_FASE:             newFase,\n  SHEET_ID_LEADS: parsed.SHEET_ID_LEADS,\n  HOJA_PREMIUM:   parsed.HOJA_PREMIUM,\n  fromPhone\n}}];\n"
      }
    },
