    {
      "id": "node-reply-parse",
      "name": "📞 Parsear Respuesta Twilio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 1220],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Twilio envía POST con Content-Type: application/x-www-form-urlencoded\n// n8n parsea los campos directamente en $json (o en $json.body según versión)\nconst wh  = $('🔔 Webhook: Respuestas Twilio').first().json;\nconst cfg = $('⚙️ CONFIG Twilio Reply').first().json;\nconst body = wh.body || wh;\n\nconst fromPhone = (body.From || '').replace(/\\D/g, '');\nconst msgBody   = (body.Body || '').trim();\nconst mediaUrl  = body.MediaUrl0 || '';\nconst isConfirm = /^(s[ií]|yes|ok|listo|confirmado|confirmo)/i.test(msgBody);\nconst isDecline = /^(no|cancel|reagend)/i.test(msgBody);\n\nreturn { json: {\n  fromPhone, msgBody, mediaUrl, isConfirm, isDecline,\n  rawFrom: body.From || '',\n  SHEET_ID:   cfg.SHEET_ID,\n  HOJA_BLOGS: cfg.HOJA_BLOGS\n}};\n"
      }
    },
    {
      "id": "node-reply-read-sheet",
      "name": "📊 Sheet: Leer Leads por Teléfono",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [960, 1220],
      "parameters": {
        "operation": "getAll",
        "documentId": { "__rl": true, "value": "={{ $json.SHEET_ID }}", "mode": "id" },
        "sheetName":  { "__rl": true, "value": "={{ $json.HOJA_BLOGS }}", "mode": "name" },
        "returnAll": true,
        "options": {}
      },
      "credentials": { "googleSheetsOAuth2Api": { "id": "SHEETS_CREDENTIAL", "name": "Google Sheets OAuth2" } }
    },
    {
      "id": "node-reply-find-row",
      "name": "🗺️ Localizar Lead por Teléfono",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1220, 1220],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const parsed    = $('📞 Parsear Respuesta Twilio').first().json;\nconst rows      = $input.all().map(i => i.json);\nconst fromPhone = parsed.fromPhone;\n\n// Buscar por teléfono en columna LEAD_PREMIUM_TELEFONO\nconst match = rows.find(r => {\n  const p = (r.LEAD_PREMIUM_TELEFONO || '').replace(/\\D/g, '');\n  return p === fromPhone || p === fromPhone.replace(/^1/, '') || '1' + p === fromPhone;\n});\n\nif (!match) {\n  return [{ json: { _noMatch: true, fromPhone, ...parsed } }];\n}\n\n// Construir nuevo contenido de INFO_RECOLECTADA\nconst now = new Date();\nconst ts  = now.toLocaleString('es-MX', { timeZone: 'America/New_York' });\nconst infoActual = match.LEAD_PREMIUM_INFO_RECOLECTADA || '';\nconst newMsg  = `[${ts} ET] ${parsed.msgBody}${parsed.mediaUrl ? '\\nFoto: ' + parsed.mediaUrl : ''}`;\nconst newInfo = infoActual ? infoActual + '\\n' + newMsg : newMsg;\n\n// Determinar fase según respuesta\nlet newFase = match.LEAD_PREMIUM_FASE || '1';\nif (parsed.isConfirm) newFase = '4';\n\nreturn [{ json: {\n  _noMatch: false,\n  rowNumber: match._rowNumber,\n  LEAD_PREMIUM_INFO_RECOLECTADA: newInfo,\n  LEAD_PREMIUM_CONFIRMADO:       parsed.isConfirm ? 'TRUE' : '',\n  LEAD_PREMIUM_FASE:             newFase,\n  SHEET_ID:   parsed.SHEET_ID,\n  HOJA_BLOGS: parsed.HOJA_BLOGS,\n  fromPhone,\n  email: match.ULTIMO_LEAD_EMAIL || ''\n}}];\n"
      }
    },
