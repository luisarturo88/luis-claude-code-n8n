    {
      "id": "node-extract",
      "name": "🔍 Extraer Datos del Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 740],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body  = $input.item.json.body || $input.item.json;\nconst cfg   = $('⚙️ CONFIG Lead Premium').first().json;\n\nconst email     = (body.email || '').trim().toLowerCase();\nconst firstName = (body.first_name || body.firstName || body.nombre || '').trim();\nconst phone     = (body.phone || body.telefono || '').trim();\nconst blogId    = String(body.blog_id || body.blogId || '').trim();\nconst blogName  = (body.blog_name || body.blogName || '').trim();\nconst leadValue = parseFloat(body.lead_value || body.leadValue || cfg.LEAD_VALUE_DEFAULT);\n\nif (!email) {\n  return { json: { _error: 'Email requerido', received: body } };\n}\n\nreturn { json: {\n  email, firstName, phone, blogId, blogName, leadValue,\n  timestamp: new Date().toISOString(),\n  SHEET_ID:   cfg.SHEET_ID,\n  HOJA_BLOGS: cfg.HOJA_BLOGS\n}};\n"
      }
    },
