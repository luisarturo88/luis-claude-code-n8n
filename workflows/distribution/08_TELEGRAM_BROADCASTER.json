{
  "name": "08_TELEGRAM_BROADCASTER",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 22 }] }
      },
      "id": "cron-trigger",
      "name": "Cada 22 Minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "documentId": { "__rl": true, "value": "18BQ8BjfTvVa56R5FjWyBuvcGR8vVlz0rx-hwAVBdPug", "mode": "id" },
        "sheetName": { "__rl": true, "value": "CONTENT_PIPELINE", "mode": "name" },
        "options": {}
      },
      "id": "read-pipeline",
      "name": "Read CONTENT_PIPELINE",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [460, 300],
      "credentials": { "googleSheetsOAuth2Api": { "name": "Google Sheets account" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "typeValidation": "loose" },
          "conditions": [
            { "id": "is-published", "leftValue": "={{ $json.STATUS }}", "rightValue": "PUBLISHED", "operator": { "type": "string", "operation": "equals" } },
            { "id": "affiliate-done", "leftValue": "={{ $json.AFFILIATE_INJECTED }}", "rightValue": "TRUE", "operator": { "type": "string", "operation": "equals" } },
            { "id": "not-telegram", "leftValue": "={{ $json.TELEGRAM_SENT }}", "rightValue": "TRUE", "operator": { "type": "string", "operation": "notEquals" } },
            { "id": "has-url", "leftValue": "={{ $json.PUBLISHED_URL }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-ready",
      "name": "Filtrar: Listos para Telegram",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [680, 300]
    },
    {
      "parameters": { "operation": "limit", "maxItems": 3 },
      "id": "take-three",
      "name": "Tomar 3 a la vez",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "const post = $input.item.json;\nconst niche = post.NICHE || 'general';\nconst lang = post.LANGUAGE || 'es';\nconst es = lang === 'es';\n\n// Emojis por nicho\nconst nicheEmoji = {\n  veterinary: '🐾', hurones: '🦡', bulldogs: '🐕', chinchillas: '🐭',\n  'exotic-pets': '🦜', seguros: '🛡️', finanzas: '💰', legal: '⚖️',\n  'legal-us': '⚖️', insurance: '🛡️', saas: '💻', ia: '🤖',\n  automatizacion: '⚙️', general: '📝'\n};\nconst emoji = nicheEmoji[niche] || '📝';\n\n// Extraer resumen del artículo (primeros 200 chars del texto plano)\nconst htmlContent = post.HTML_CONTENT || '';\nconst plainText = htmlContent\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .substring(0, 220)\n  .replace(/[\\[\\]()]/g, '');\nconst excerpt = plainText.length > 200 ? plainText.substring(0, 200) + '...' : plainText;\n\n// Hashtags por nicho\nconst hashtagMap = {\n  veterinary: '#veterinaria #mascotas #salud',\n  hurones: '#hurones #mascotas #animales',\n  bulldogs: '#bulldogs #perros #mascotas',\n  seguros: '#seguros #finanzas #proteccion',\n  finanzas: '#finanzas #dinero #ahorro',\n  insurance: '#insurance #finance #money',\n  'legal-us': '#legal #law #rights',\n  saas: '#saas #software #tecnologia',\n  ia: '#ia #inteligenciaartificial #tecnologia',\n  general: '#contenido #blog'\n};\nconst hashtags = hashtagMap[niche] || '#blog #contenido';\n\nlet message;\nif (es) {\n  message = `${emoji} <b>${post.TITLE}</b>\\n\\n${excerpt}\\n\\n🔗 <a href=\"${post.PUBLISHED_URL}\">Leer artículo completo</a>\\n\\n${hashtags}`;\n} else {\n  message = `${emoji} <b>${post.TITLE}</b>\\n\\n${excerpt}\\n\\n🔗 <a href=\"${post.PUBLISHED_URL}\">Read full article</a>\\n\\n${hashtags}`;\n}\n\nreturn {\n  json: {\n    ROW_NUMBER: post.ROW_NUMBER,\n    message,\n    TELEGRAM_CHAT_ID: '<!-- TELEGRAM_CHAT_ID -->',\n    TITLE: post.TITLE,\n    PUBLISHED_URL: post.PUBLISHED_URL\n  }\n};"
      },
      "id": "build-message",
      "name": "Construir Mensaje Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $json.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "disable_web_page_preview": false
        }
      },
      "id": "send-telegram",
      "name": "Enviar a Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1340, 300],
      "credentials": { "telegramApi": { "name": "Telegram Bot production" } },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "value": "18BQ8BjfTvVa56R5FjWyBuvcGR8vVlz0rx-hwAVBdPug", "mode": "id" },
        "sheetName": { "__rl": true, "value": "CONTENT_PIPELINE", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "ROW_NUMBER": "={{ $('Construir Mensaje Telegram').item.json.ROW_NUMBER }}",
            "TELEGRAM_SENT": "TRUE"
          },
          "matchingColumns": ["ROW_NUMBER"],
          "schema": [
            {"id": "ROW_NUMBER", "displayName": "ROW_NUMBER", "required": false, "defaultMatch": true, "canBeUsedToMatch": true, "display": true, "type": "string", "removed": false},
            {"id": "TELEGRAM_SENT", "displayName": "TELEGRAM_SENT", "required": false, "defaultMatch": false, "canBeUsedToMatch": false, "display": true, "type": "string", "removed": false}
          ]
        },
        "options": {}
      },
      "id": "mark-sent",
      "name": "Marcar TELEGRAM_SENT=TRUE",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1560, 260],
      "credentials": { "googleSheetsOAuth2Api": { "name": "Google Sheets account" } }
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "value": "18BQ8BjfTvVa56R5FjWyBuvcGR8vVlz0rx-hwAVBdPug", "mode": "id" },
        "sheetName": { "__rl": true, "value": "CONTENT_PIPELINE", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "ROW_NUMBER": "={{ $('Construir Mensaje Telegram').item.json.ROW_NUMBER }}",
            "ERROR_MESSAGE": "Telegram error: post publicado pero sin distribuir"
          },
          "matchingColumns": ["ROW_NUMBER"],
          "schema": [
            {"id": "ROW_NUMBER", "displayName": "ROW_NUMBER", "required": false, "defaultMatch": true, "canBeUsedToMatch": true, "display": true, "type": "string", "removed": false},
            {"id": "ERROR_MESSAGE", "displayName": "ERROR_MESSAGE", "required": false, "defaultMatch": false, "canBeUsedToMatch": false, "display": true, "type": "string", "removed": false}
          ]
        },
        "options": {}
      },
      "id": "mark-error",
      "name": "Log Error Telegram",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1560, 420],
      "credentials": { "googleSheetsOAuth2Api": { "name": "Google Sheets account" } }
    }
  ],
  "connections": {
    "Cada 22 Minutos": { "main": [[{"node": "Read CONTENT_PIPELINE", "type": "main", "index": 0}]] },
    "Read CONTENT_PIPELINE": { "main": [[{"node": "Filtrar: Listos para Telegram", "type": "main", "index": 0}]] },
    "Filtrar: Listos para Telegram": { "main": [[{"node": "Tomar 3 a la vez", "type": "main", "index": 0}]] },
    "Tomar 3 a la vez": { "main": [[{"node": "Construir Mensaje Telegram", "type": "main", "index": 0}]] },
    "Construir Mensaje Telegram": { "main": [[{"node": "Enviar a Telegram", "type": "main", "index": 0}]] },
    "Enviar a Telegram": { "main": [
      [{"node": "Marcar TELEGRAM_SENT=TRUE", "type": "main", "index": 0}],
      [{"node": "Log Error Telegram", "type": "main", "index": 0}]
    ]}
  },
  "settings": { "executionOrder": "v1", "saveManualExecutions": true, "callerPolicy": "workflowsFromSameOwner", "executionTimeout": 120 },
  "meta": { "instanceId": "production" }
}
