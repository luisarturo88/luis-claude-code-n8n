            {"id": "INTERLINKS_ADDED", "displayName": "INTERLINKS_ADDED", "required": false, "defaultMatch": false, "canBeUsedToMatch": false, "display": true, "type": "string", "removed": false}
          ]
        },
        "options": {}
      },
      "id": "mark-interlinks-added-without",
      "name": "Marcar INTERLINKS_ADDED=TRUE (sin links)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1560, 420],
      "credentials": { "googleSheetsOAuth2Api": { "name": "Google Sheets account" } }
    }
  ],
  "connections": {
    "Cada 4 Horas": { "main": [[{"node": "Read CONTENT_PIPELINE", "type": "main", "index": 0}]] },
